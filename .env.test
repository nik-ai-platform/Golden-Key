# Test environment (CI/local test DB)
ENVIRONMENT=testing
DATABASE_URL=postgresql://goldenkey:password@localhost:5432/goldenkey_test
REDIS_URL=redis://localhost:6379/1
SECRET_KEY=<set-test-secret>
JWT_SECRET=<set-test-jwt-secret>
OPENAI_API_KEY=<set-test-openai-key>
SPORTSBOOK_API_KEYS={"odds_api":"<set-test-odds-api-key>"}
SMTP_SETTINGS={"host":"smtp.test.local","port":1025,"username":"test","password":"test","from_email":"test@example.com","use_tls":false}
AUTH_DEMO_EMAIL=test-admin@example.com
AUTH_DEMO_PASSWORD=<set-test-demo-password>
ACCESS_TOKEN_EXPIRE_MINUTES=15
API_URL=http://localhost:8000
ODDS_API_KEY=<optional-test-odds-key>
