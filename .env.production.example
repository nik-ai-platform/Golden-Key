POSTGRES_DB=goldenkey
POSTGRES_USER=goldenkey
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

SECRET_KEY=REPLACE_WITH_SECURE_SECRET
JWT_SECRET=REPLACE_WITH_DIFFERENT_REAL_RANDOM_SECRET

OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
SPORTSBOOK_API_KEYS={"odds_api":"REPLACE_WITH_PROVIDER_KEY"}
ODDS_API_KEY=REPLACE_WITH_ODDS_API_KEY
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

REDIS_URL=redis://YOUR_REDIS_HOST:6379/0
# Confirm host/STARTTLS port in the mailbox provider; credentials belong only in secret storage.
SMTP_SETTINGS={"host":"YOUR_SMTP_HOST","port":587,"username":"owner@bearahandllc.com","password":"YOUR_PASSWORD","from_email":"owner@bearahandllc.com","from_name":"Bear A Hand Sports Support","use_tls":true}

STRIPE_TEST_MODE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_IDS={"pro_monthly":"price_monthly_placeholder","pro_annual":"price_annual_placeholder"}
# Monthly must resolve to active test-mode USD 9.99/month; reuse only after verification.
# Create/configure a separate active test-mode USD 89.99/year price; do not reuse the legacy annual price.
# Both offers retain a seven-day trial. Placeholders are not real Price IDs.

AUTH_DEMO_EMAIL=admin@example.com
AUTH_DEMO_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

FRONTEND_URL=https://bearahandsports.com
CORS_ORIGINS=https://bearahandsports.com,https://www.bearahandsports.com,https://goldenkeysports.com,https://www.goldenkeysports.com
NEXT_PUBLIC_API_URL=https://api.bearahandsports.com/api/v1
VITE_API_BASE_URL=https://api.bearahandsports.com/api/v1

# Storage foundation only; worker/API integration is not enabled in Phase 1A.1.
OPERATIONS_TELEMETRY_ENABLED=false
OPERATIONS_CYCLE_RETENTION_DAYS=30
OPERATIONS_STARTUP_GRACE_SECONDS=120
OPERATIONS_TELEMETRY_STATEMENT_TIMEOUT_MS=500
OPERATIONS_TELEMETRY_LOCK_TIMEOUT_MS=100
OPERATIONS_TELEMETRY_POOL_TIMEOUT_SECONDS=0.2
OPERATIONS_TELEMETRY_CONNECT_TIMEOUT_SECONDS=2