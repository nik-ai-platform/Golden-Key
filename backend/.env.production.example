ENVIRONMENT=production
DEBUG=false

DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/DATABASE_NAME

SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

FRONTEND_URL=https://YOUR_DOMAIN.com
CORS_ORIGINS=https://YOUR_DOMAIN.com

# Confirm provider host/STARTTLS port; never commit real SMTP credentials.
SMTP_SETTINGS={"host":"YOUR_SMTP_HOST","port":587,"username":"owner@bearahandllc.com","password":"YOUR_PASSWORD","from_email":"owner@bearahandllc.com","from_name":"Bear A Hand Sports Support","use_tls":true}

ACCESS_TOKEN_EXPIRE_MINUTES=60

ODDS_API_KEY=REPLACE_WITH_PROVIDER_KEY

# Stripe remains disabled until separately approved sandbox configuration.
STRIPE_TEST_MODE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_IDS={"pro_monthly":"price_monthly_placeholder","pro_annual":"price_annual_placeholder"}
# Verify active test-mode USD 9.99/month before reusing a monthly price.
# Separately create/configure active test-mode USD 89.99/year; do not reuse the legacy annual price.
# Both offers retain a seven-day trial. Never commit real provider credentials or Price IDs.

# Isolated telemetry storage (disabled until a later guarded rollout).
OPERATIONS_TELEMETRY_ENABLED=false
OPERATIONS_CYCLE_RETENTION_DAYS=30
OPERATIONS_STARTUP_GRACE_SECONDS=120
OPERATIONS_TELEMETRY_STATEMENT_TIMEOUT_MS=500
OPERATIONS_TELEMETRY_LOCK_TIMEOUT_MS=100
OPERATIONS_TELEMETRY_POOL_TIMEOUT_SECONDS=0.2
OPERATIONS_TELEMETRY_CONNECT_TIMEOUT_SECONDS=2
