APP_NAME=Nik AI Sports Betting Platform
VERSION=1.0.0
ENVIRONMENT=development

# Docker Postgres is published on host port 5433 to avoid conflicts with local Postgres.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/nikai
REDIS_URL=redis://127.0.0.1:6379/0

# Required secrets (set real values in local/CI secret stores)
SECRET_KEY=replace-with-strong-secret-key
JWT_SECRET=replace-with-strong-jwt-secret
OPENAI_API_KEY=replace-with-openai-key
AUTH_DEMO_EMAIL=admin@example.com
AUTH_DEMO_PASSWORD=replace-with-demo-password

# Required JSON object values
SPORTSBOOK_API_KEYS={"odds_api":"replace-with-odds-api-key"}
SMTP_SETTINGS={"host":"smtp.example.com","port":587,"username":"mailer@example.com","password":"replace-with-smtp-password","from_email":"no-reply@example.com","use_tls":true}

DEBUG=True
