APP_NAME=Nik AI Sports Betting Platform
VERSION=1.0.0
ENVIRONMENT=development

# Docker Postgres is published on host port 5433 to avoid conflicts with local Postgres.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/nikai
REDIS_URL=redis://127.0.0.1:6379/0

# Required secrets (set real values in local/CI secret stores)
SECRET_KEY=replace-with-strong-secret-key
JWT_SECRET=replace-with-strong-jwt-secret
OPENAI_API_KEY=replace-with-openai-key
CFBD_API_KEY=replace-with-cfbd-api-key
CFBD_API_BASE_URL=https://api.collegefootballdata.com
AUTH_DEMO_EMAIL=admin@example.com
AUTH_DEMO_PASSWORD=replace-with-demo-password

# Required JSON object values
SPORTSBOOK_API_KEYS={"odds_api":"replace-with-odds-api-key"}
# Intended customer sender; confirm SMTP host/STARTTLS port before enabling real delivery.
SMTP_SETTINGS={"host":"smtp.example.com","port":587,"username":"owner@bearahandllc.com","password":"replace-with-smtp-password","from_email":"owner@bearahandllc.com","from_name":"Bear A Hand Sports Support","use_tls":true}

# Optional Stripe sandbox billing. Only sk_test_ keys are accepted.
STRIPE_TEST_MODE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_IDS={"pro_monthly":"price_monthly_placeholder","pro_annual":"price_annual_placeholder"}

# Optional Apple subscription verification. Keep disabled until sandbox values are supplied.
APPLE_SUBSCRIPTIONS_ENABLED=false
APPLE_BUNDLE_ID=
APPLE_PRO_MONTHLY_PRODUCT_ID=
APPLE_PRO_ANNUAL_PRODUCT_ID=
APPLE_APP_STORE_ENVIRONMENT=sandbox
APPLE_APP_STORE_ISSUER_ID=
APPLE_APP_STORE_KEY_ID=
APPLE_APP_STORE_PRIVATE_KEY=
APPLE_APPLE_ID=
APPLE_ROOT_CA_PATHS=[]
APPLE_ENABLE_ONLINE_CHECKS=false

DEBUG=True

# Isolated telemetry storage (disabled until a later guarded rollout).
OPERATIONS_TELEMETRY_ENABLED=false
OPERATIONS_CYCLE_RETENTION_DAYS=30
OPERATIONS_STARTUP_GRACE_SECONDS=120
OPERATIONS_TELEMETRY_STATEMENT_TIMEOUT_MS=500
OPERATIONS_TELEMETRY_LOCK_TIMEOUT_MS=100
OPERATIONS_TELEMETRY_POOL_TIMEOUT_SECONDS=0.2
OPERATIONS_TELEMETRY_CONNECT_TIMEOUT_SECONDS=2
